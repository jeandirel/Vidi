# Copy to .env at the repository root. NEVER commit .env or service credentials.
DATABASE_URL=postgresql://vidi:vidi_local_only@localhost:5432/vidi?schema=public
REDIS_URL=redis://localhost:6379
# Free text generation through Vercel AI Gateway (OIDC on Vercel; no browser key).
LLM_PROVIDER=vercel
AI_GATEWAY_MODEL=nvidia/nemotron-3.5-lightning-free
LLM_FREE_ONLY=true
LLM_GUEST_ENABLED=false
# Optional outside Vercel: keep the gateway key server-side.
AI_GATEWAY_API_KEY=
# UGC pipeline: Gemini Omni generates 6-10s B-roll, HeyGen is optional
# for talking avatars; ElevenLabs is optional for voiceover on product clips.
# Generated exports need durable worker + PostgreSQL + Redis + private S3/R2.
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# HeyGen API (Industry-Leading Hyper-Realistic AI Avatars & Talking Videos)
# Obtain in HeyGen Space Settings > API > API Key (https://app.heygen.com/settings?nav=API)
HEYGEN_API_KEY=

# Optional OpenShorts MIT-core UGC engine (apps/worker + web, see docs/openshorts-integration.md).
# Deploy a PRIVATE HTTPS OpenShorts instance behind a bearer-authenticated reverse proxy.
OPENSHORTS_API_URL=
OPENSHORTS_SERVICE_TOKEN=
OPENSHORTS_FAL_KEY=
OPENSHORTS_ELEVENLABS_KEY=
OPENSHORTS_VOICE_ID=

# Video gateway contract: docs/video-gateway.md. Optional if HEYGEN_API_KEY is used.
VIDEO_GATEWAY_URL=
VIDEO_GATEWAY_TOKEN=
VIDEO_OUTPUT_HOSTS=
# Optional S3/R2 uploads. Credentials follow the AWS SDK credential chain.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional operator-controlled webhook. Never accept arbitrary URLs from public input.
WEBHOOK_URL=
WEBHOOK_SECRET=

# Google OAuth 2.0 (Google Sign-In)
# Obtain in Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional Stripe billing. Leave empty to keep checkout disabled.
APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# Per-workspace integration secret encryption; use a different key in each environment.
# Generate once: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('hex'))"
VIDI_INTEGRATION_KEY=
# Native self-hosted media service (alternative to VIDEO_GATEWAY_URL).
MEDIA_GATEWAY_URL=
MEDIA_GATEWAY_TOKEN=
# Gateway host variables; never expose these in the browser.
MEDIA_TRANSFER_HOSTS=
MEDIA_INSTALL_TTS=false
MEDIA_ENABLE_TTS=false
MEDIA_DEVICE=cpu
# Optional explicit Stripe portal configuration created by scripts/setup-billing.mjs.
STRIPE_PORTAL_CONFIGURATION=
