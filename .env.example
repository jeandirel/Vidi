# Copy to .env at the repository root. NEVER commit .env or service credentials.
DATABASE_URL=postgresql://vidi:vidi_local_only@localhost:5432/vidi?schema=public
REDIS_URL=redis://localhost:6379
# Free text generation through Vercel AI Gateway (OIDC on Vercel; no browser key).
LLM_PROVIDER=vercel
AI_GATEWAY_MODEL=nvidia/nemotron-3.5-lightning-free
LLM_FREE_ONLY=true
LLM_GUEST_ENABLED=false
# Optional outside Vercel: keep the gateway key server-side.
AI_GATEWAY_API_KEY=
# Video gateway contract: docs/video-gateway.md. This is NOT a built-in video provider.
VIDEO_GATEWAY_URL=
VIDEO_GATEWAY_TOKEN=
VIDEO_OUTPUT_HOSTS=
# Optional S3/R2 uploads. Credentials follow the AWS SDK credential chain.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional operator-controlled webhook. Never accept arbitrary URLs from public input.
WEBHOOK_URL=
WEBHOOK_SECRET=

# Optional Stripe billing. Leave empty to keep checkout disabled.
APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=
