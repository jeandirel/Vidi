{
  "name": "vidi",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @vidi/web",
    "build": "npm run build -w @vidi/web",
    "start": "npm run start -w @vidi/web",
    "worker": "npm run start -w @vidi/worker",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit && tsc -p apps/worker/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:dev": "prisma migrate dev --schema packages/db/prisma/schema.prisma"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.56.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "prisma": "6.19.0",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
