generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  OWNER
  EDITOR
  VIEWER
}
enum RenderStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  sessions Session[]
  memberships Membership[]
  apiKeys ApiKey[]
  reviews ProjectReview[]
  createdAt DateTime @default(now())
}
model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}
model Workspace {
  id String @id @default(cuid())
  name String
  plan String @default("starter")
  credits Int @default(0)
  memberships Membership[]
  projects Project[]
  renders Render[]
  ledger CreditEntry[]
  apiKeys ApiKey[]
  invitations Invitation[]
  assets Asset[]
  subscription Subscription?
  connections ServiceConnection[]
  voiceProfiles VoiceProfile[]
  voiceGenerations VoiceGeneration[]
  createdAt DateTime @default(now())
}
model Membership {
  userId String
  workspaceId String
  role Role @default(VIEWER)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@id([userId,workspaceId])
}
model Project {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title String
  data Json
  renders Render[]
  revision Int @default(1)
  reviewStatus ReviewStatus @default(DRAFT)
  requiresApproval Boolean @default(false)
  archivedAt DateTime?
  reviews ProjectReview[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([workspaceId,updatedAt])
}
model Render {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  idempotencyKey String
  input Json
  credits Int
  status RenderStatus @default(QUEUED)
  outputUrl String?
  outputAssetId String?
  providerJobId String?
  error String?
  ledger CreditEntry[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([workspaceId,idempotencyKey])
  @@index([workspaceId,status])
}
model CreditEntry {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  renderId String?
  render Render? @relation(fields: [renderId], references: [id])
  amount Int
  reason String
  createdAt DateTime @default(now())
  @@unique([renderId,reason])
  @@index([workspaceId,createdAt])
}

enum ReviewStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  CHANGES_REQUESTED
}
model ApiKey {
  id String @id @default(cuid())
  name String
  prefix String
  tokenHash String @unique
  workspaceId String
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  role Role @default(VIEWER)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([workspaceId,createdAt])
}
model Invitation {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  email String
  role Role @default(VIEWER)
  tokenHash String @unique
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime @default(now())
  @@index([workspaceId,expiresAt])
}
model ProjectReview {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  authorId String
  author User @relation(fields:[authorId],references:[id],onDelete:Cascade)
  revision Int
  decision ReviewStatus
  message String
  createdAt DateTime @default(now())
  @@index([projectId,createdAt])
}
model Asset {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  key String @unique
  name String
  mime String
  size Int
  confirmedAt DateTime?
  voiceProfiles VoiceProfile[]
  createdAt DateTime @default(now())
  @@index([workspaceId,createdAt])
}
model Subscription {
  id String @id @default(cuid())
  workspaceId String @unique
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  customerId String @unique
  stripeId String? @unique
  status String @default("pending")
  checkoutKey String?
  checkoutPlan String?
  checkoutSessionId String?
  checkoutLockedUntil DateTime?
  updatedAt DateTime @updatedAt
}
model BillingEvent {
  id String @id
  type String
  createdAt DateTime @default(now())
}

model RateLimitBucket {
  key String @id
  count Int
  expiresAt DateTime
  @@index([expiresAt])
}

model ServiceConnection {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  provider String
  config Json
  sealedSecret String?
  checkedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([workspaceId,provider])
}
model VoiceProfile {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  name String
  sourceAssetId String?
  sourceAsset Asset? @relation(fields:[sourceAssetId],references:[id],onDelete:SetNull)
  consentUserId String
  consentVersion String
  consentAt DateTime @default(now())
  revokedAt DateTime?
  generations VoiceGeneration[]
  @@index([workspaceId,consentAt])
}
model VoiceGeneration {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  profileId String
  profile VoiceProfile @relation(fields:[profileId],references:[id],onDelete:Cascade)
  idempotencyKey String
  text String
  language String
  emotion String
  status RenderStatus @default(QUEUED)
  outputAssetId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([workspaceId,idempotencyKey])
  @@index([workspaceId,status])
}
