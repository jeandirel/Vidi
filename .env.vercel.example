# ==============================================================================
# VIDI — VERCEL ENVIRONMENT CONFIGURATION TEMPLATE (.env.vercel.example)
# ==============================================================================
# Cet exemple liste toutes les variables requises ou recommandées pour le déploiement
# sur Vercel (Frontend Next.js + Serverless API).
#
# IMPORTANT : NE JAMAIS COMMITER DE SECRETS DANS LE DÉPÔT GIT.
# Renseignez ces variables dans le tableau de bord Vercel :
# Settings > Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. URL & ENVIRONNEMENT (Production, Preview, Development)
# ------------------------------------------------------------------------------
# Définir avec l'URL de votre domaine ou l'alias de déploiement Vercel.
APP_URL=https://vidi.ai
NEXT_PUBLIC_APP_URL=https://vidi.ai

# ------------------------------------------------------------------------------
# 2. BASE DE DONNÉES POSTGRESQL (NÉCESSAIRE POUR LES COMPTES ET PROJETS CLOUD)
# ------------------------------------------------------------------------------
# Fourni par : Neon Serverless Postgres, Supabase ou AWS RDS
# Format : postgresql://user:password@endpoint-pooler.region.neon.tech/vidi?sslmode=require&schema=public
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. REDIS DISTRIBUÉ (FILE D'ATTENTE BULLMQ & RATE LIMITING)
# ------------------------------------------------------------------------------
# Fourni par : Upstash Redis ou Redis Cloud
# Format : rediss://default:token@region.upstash.io:6379
REDIS_URL=

# ------------------------------------------------------------------------------
# 4. PASSERELLE IA / LLM (GÉNÉRATEUR DE SCRIPTS PUBLICITAIRES)
# ------------------------------------------------------------------------------
# Fourni par : Vercel AI Gateway (intégré) ou clé API dédiée
LLM_PROVIDER=vercel
AI_GATEWAY_MODEL=nvidia/nemotron-3.5-lightning-free
LLM_FREE_ONLY=true
LLM_GUEST_ENABLED=true
# Optionnel sur Vercel si l'OIDC est actif. Obligatoire si clé externe utilisée :
AI_GATEWAY_API_KEY=

# ------------------------------------------------------------------------------
# 5. CHIFFREMENT DES INTÉGRATIONS DE WORKSPACE (SHOPIFY, WOOCOMMERCE, YOUTUBE)
# ------------------------------------------------------------------------------
# Générer une clé unique de 32 octets en hexadécimal (64 caractères) :
# Commande : node -e "process.stdout.write(require('crypto').randomBytes(32).toString('hex'))"
VIDI_INTEGRATION_KEY=

# ------------------------------------------------------------------------------
# 6. STOCKAGE MÉDIA PRIVÉ (CLOUDFLARE R2 OU AWS S3)
# ------------------------------------------------------------------------------
# Utilisé pour stocker les images produits, pistes audio et exports vidéo MP4 finaux.
# Fourni par : Cloudflare R2 (recommandé sans frais d'egress) ou AWS S3
S3_BUCKET=vidi-media-production
S3_REGION=auto
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 7. PASSERELLE MÉDIA VIDI (MOTEUR FFMPEG / GPU HORS SERVERLESS)
# ------------------------------------------------------------------------------
# Important : Le rendu vidéo lourd et le conteneur FFmpeg s'exécutent sur un VPS / Worker dédié
# et NE PEUVENT PAS tourner dans une fonction Vercel Serverless limitée à 60s.
MEDIA_GATEWAY_URL=https://media.vidi.ai
MEDIA_GATEWAY_TOKEN=
MEDIA_TRANSFER_HOSTS=media.vidi.ai

# Alternative externe (si utilisation d'un autre fournisseur de rendu vidéo) :
VIDEO_GATEWAY_URL=
VIDEO_GATEWAY_TOKEN=
VIDEO_OUTPUT_HOSTS=

# ------------------------------------------------------------------------------
# 8. FACTURATION & PAIEMENTS STRIPE (OPTIONNEL EN LOCAL, ACTIF EN PRODUCTION)
# ------------------------------------------------------------------------------
# Fourni par : Dashboard Stripe (Mode Test ou Mode Live)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=price_starter_99
STRIPE_PRICE_PRO=price_pro_299
STRIPE_PRICE_AGENCY=price_agency_999
STRIPE_PORTAL_CONFIGURATION=

# ------------------------------------------------------------------------------
# 9. NOTIFICATIONS ET EMAILS DE CONTACT (OPTIONNEL)
# ------------------------------------------------------------------------------
# Fourni par : Resend (https://resend.com) ou Postmark
RESEND_API_KEY=
EMAIL_FROM=contact@vidi.ai
CONTACT_NOTIFICATION_EMAIL=support@vidi.ai

# ------------------------------------------------------------------------------
# 10. AUTHENTIFICATION GOOGLE OAUTH 2.0 (CONNEXION EN UN CLIC)
# ------------------------------------------------------------------------------
# Fourni par : Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Web Client)
# URI de redirection autorisée à déclarer sur Google Cloud :
# https://votre-projet.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://votre-projet.vercel.app/api/auth/google/callback

